# ==============================================================================
# .env.example — Contrato de entorno (12-Factor, factor III: Config)
# ==============================================================================
# NOTAS DE ARQUITECTURA PARA EL ALUMNO
#
#  - Este fichero SÍ se versiona y contiene SOLO valores ficticios (dummy).
#  - El fichero `.env` (con tus valores reales) NO se versiona nunca.
#  - Uso:   cp .env.example .env     y rellena tus valores.
#  - Es un CONTRATO: el código conoce los NOMBRES de las variables, nunca sus
#    valores. El backend comprueba al arrancar que existen las obligatorias
#    (ver backend/src/config/env.js) y se detiene con un mensaje claro si falta
#    alguna: «fallar pronto» en lugar de fallar a mitad de una petición.
#  - Se actualiza EN EL MISMO COMMIT que introduce una variable nueva en el código.
#  - Un valor de ejemplo NUNCA debe funcionar en un sistema real. Si pones una
#    contraseña que parece real, el contrato se convierte en una fuga.
#  - Los NOMBRES dependen de tu stack: el .env.example del aula virtual usa
#    DB_DATABASE/DB_USERNAME (estilo Laravel) y aquí DB_NAME/DB_USER. Lo que se
#    exige es coherencia entre lo que lee TU código y lo que documenta TU contrato.
#  - Variables marcadas [OPCIONAL] NO las lee el esqueleto: son ejemplos de
#    add-ons. Borra las que tu proyecto no use (un contrato con variables
#    muertas confunde tanto como uno al que le faltan).
#
# Prueba de fuego: ¿podrías hacer público tu repo ahora mismo sin comprometer
# ninguna credencial? Si dudas, revisa este fichero y tu .gitignore.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. ENTORNO Y SERVIDOR
# ------------------------------------------------------------------------------
# Modo de ejecución. Formato: development | test | production
# En production se ocultan trazas de error (nunca stack traces al cliente).
NODE_ENV=development

# Puerto interno del backend. Formato: número entero.
# En PaaS (Render, Railway) el proveedor suele inyectarlo: no lo fuerces allí.
PORT=3000

# Origen del frontend autorizado por CORS. Formato: URL COMPLETA con protocolo
# y sin barra final (http://localhost:5173), NO solo el host.
# ADVERTENCIA: en producción pon el dominio HTTPS real del frontend. Nunca uses
# el comodín `*` si manejas credenciales (rúbrica del Hito 3).
CORS_ORIGIN=http://localhost:5173


# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Aquí se usan variables sueltas. Si tu ORM exige una cadena única, define
# DATABASE_URL en su lugar (formato: mysql://usuario:clave@host:3306/nombre_bd)
# y ELIMINA estas cinco: no mantengas dos fuentes de verdad.

# SOLO el host (nombre o IP), sin protocolo ni puerto.
#   - Desarrollo nativo:  127.0.0.1
#   - Docker Compose:     el nombre del servicio (p. ej. `database`)
#   - Producción:         el host que te da el proveedor (RDS, Railway, Neon...)
DB_HOST=127.0.0.1

# Puerto de la BD. Formato: entero. MySQL/MariaDB: 3306 · PostgreSQL: 5432.
DB_PORT=3306

# Nombre de la base de datos. Usa un nombre distinto por entorno (_dev, _test).
DB_NAME=gestaller_dev

# Usuario de aplicación con permisos mínimos sobre ESA base de datos.
# ADVERTENCIA: nunca uses `root` en la aplicación.
DB_USER=gestaller_user

# Contraseña (valor ficticio). En tu .env real: única por entorno y distinta de
# cualquier otra que uses. Nunca la pegues en el código, en el README ni en un issue.
DB_PASSWORD=change_me_dummy_password


# ------------------------------------------------------------------------------
# 3. AUTENTICACIÓN (JWT + bcrypt)
# ------------------------------------------------------------------------------
# Secreto de firma de los JWT (HS256). Debe ser aleatorio y de AL MENOS 32 BYTES
# (256 bits). Genera uno de 32 bytes en terminal:
#
#     openssl rand -base64 32
#
# (salen 44 caracteres: copia el resultado entero en tu .env, NUNCA aquí).
# ADVERTENCIAS: no uses frases con significado ni valores como `secret123`; un
# secreto corto o adivinable se rompe por fuerza bruta offline y permite forjar
# tokens de administrador. Si se filtra, hay que ROTARLO e invalida todas las
# sesiones activas. El backend rechaza arrancar con menos de 32 caracteres.
JWT_SECRET=replace_with_openssl_rand_base64_32_output_never_commit_the_real_one

# Caducidad del access token. Formato jsonwebtoken: 15m, 1h, 2h, 7d.
# Regla del Hito 2: máximo 2 horas. Cuanto más corto, menor el daño si lo roban.
JWT_EXPIRES_IN=1h

# Coste (rondas de sal) de bcrypt. Formato: entero. Mínimo exigido: 10.
# Recomendado: 12 (≈250 ms por hash). Más coste = más lento para un atacante,
# pero también para tu login: mídelo antes de subirlo.
BCRYPT_SALT_ROUNDS=12


# ------------------------------------------------------------------------------
# 4. ALMACENAMIENTO Y APIs EXTERNAS  [OPCIONAL: ejemplos de add-ons]
# ------------------------------------------------------------------------------
# Driver de almacenamiento de ficheros. Valores: local | s3
STORAGE_DRIVER=local

# Ruta RELATIVA donde se guardan las subidas si el driver es `local`.
# Esa carpeta está ignorada por .gitignore (los ficheros son datos, no código).
STORAGE_LOCAL_PATH=./uploads

# Solo si STORAGE_DRIVER=s3. Región: código AWS (us-east-1).
# Bucket: SOLO el nombre, no la URL (s3://...) ni el ARN.
# ADVERTENCIA AWS Academy: en el Learner Lab NO crees usuarios IAM ni pongas
# claves en este fichero; la EC2 usa el perfil LabInstanceProfile (LabRole) y el
# SDK obtiene credenciales temporales automáticamente.
AWS_REGION=us-east-1
S3_BUCKET=gestaller-dev-uploads

# API de correo transaccional (ejemplo). Clave ficticia.
# ADVERTENCIA: las claves de terceros son secretos. Una clave `live`/`prod` jamás
# debe estar aquí; usa claves de sandbox/test (p. ej. prefijos pk_test_ / sk_test_).
MAIL_API_KEY=dummy_api_key_not_real
# Formato: dirección de email válida del dominio remitente verificado.
MAIL_FROM=no-reply@gestaller.example


# ------------------------------------------------------------------------------
# 5. FRONTEND (Vite)
# ------------------------------------------------------------------------------
# URL COMPLETA de la API, con protocolo y prefijo de versión, sin barra final.
#   - Local:       http://localhost:3000/api/v1
#   - Producción:  https://api-tu-proyecto.onrender.com/api/v1   (HTTPS obligatorio)
# ADVERTENCIA CRÍTICA: Vite solo expone al navegador las variables con prefijo
# VITE_, y TODO lo que llega al navegador es PÚBLICO (cualquiera lo ve en las
# DevTools). NUNCA pongas aquí secretos, claves ni contraseñas.
# Cero `localhost` en producción: es una regla eliminatoria del Hito 3.
VITE_API_URL=http://localhost:3000/api/v1
