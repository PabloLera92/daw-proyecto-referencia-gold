# ============================================================
# .env.example — Contrato de entorno (12-Factor, factor III)
# Copia este archivo:  cp .env.example .env
# NUNCA subas .env al repositorio. Aquí solo van valores DUMMY.
# ============================================================

# --- 1. ENTORNO Y SERVIDOR ---------------------------------
# development | test | production
NODE_ENV=development
# Puerto del backend (el frontend de Vite usa 5173)
PORT=3000
# Origen permitido por CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# --- 2. BASE DE DATOS (MySQL/MariaDB) ----------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gestaller_dev
DB_USER=gestaller_user
# Dummy: en tu .env real usa una contraseña propia y distinta por entorno
DB_PASSWORD=change_me_dummy_password

# --- 3. AUTENTICACIÓN JWT ----------------------------------
# Secreto de firma: mínimo 32 caracteres aleatorios (256 bits).
# Genera uno real con:  openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_chars_xxxxxxxx
# Caducidad del access token (formato jsonwebtoken: 15m, 1h, 7d)
JWT_EXPIRES_IN=1h
# Coste de bcrypt (10-12 recomendado)
BCRYPT_SALT_ROUNDS=12

# --- 4. STORAGE Y APIS EXTERNAS ----------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# Solo si STORAGE_DRIVER=s3 (en AWS Academy usa LabRole, sin claves en el repo)
AWS_REGION=us-east-1
S3_BUCKET=gestaller-dev-uploads
# API externa opcional (p. ej. avisos por email). Clave dummy.
MAIL_API_KEY=dummy_api_key_not_real
MAIL_FROM=no-reply@gestaller.example

# --- 5. FRONTEND (Vite: solo variables con prefijo VITE_) ---
# NUNCA pongas secretos aquí: el bundle del frontend es público.
VITE_API_URL=http://localhost:3000/api/v1
